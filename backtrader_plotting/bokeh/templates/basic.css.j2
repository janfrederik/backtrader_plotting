<style>
    body {
        {% if body_background_color %}background-color: {{body_background_color}};{% endif %}
        {% if text_color %}color: {{text_color}};{% endif %}
    }

    table.metaDataTable {
      border: 1px solid #1C6EA4;
      {% if datatable_row_color_odd %}background-color: {{datatable_row_color_odd}};{% endif %}
      width: 100%;
      text-align: left;
      border-collapse: collapse;
    }
    table.metaDataTable td, table.metaDataTable th {
      {% if datatable_row_color_odd %}border: 1px solid {{datatable_row_color_odd}};{% endif %}
      padding: 3px 2px;
    }
    table.metaDataTable tbody td {
      font-size: 13px;
    }
    table.metaDataTable tr:nth-child(even) {
      {% if datatable_row_color_even %}background: {{datatable_row_color_even}};{% endif %}
    }
    table.metaDataTable tfoot td {
      font-size: 14px;
    }
    table.metaDataTable tfoot .links {
      text-align: right;
    }
    table.metaDataTable tfoot .links a{
      display: inline-block;
      background: #1C6EA4;
      color: #FFFFFF;
      padding: 2px 8px;
      border-radius: 5px;
    }

    pre {
      {% if tag_pre_background_color %}background-color: {{tag_pre_background_color}};{% endif %}
      {% if tag_pre_text_color %}color: {{tag_pre_text_color}};{% endif %}
    }

    #headline {
        font-size: 200%;
        font-family: "Segoe UI", "Arial Black", Gadget, sans-serif;
        {% if headline_color %}color: {{headline_color}};{% endif %}
    }

    .bk-root {
        font-family: "Segoe UI", "Arial Black", Gadget, sans-serif;
    }
    .bk-toolbar {position: fixed;}

    .slick-header-column {
        {% if datatable_header_color %}
        background-color: {{datatable_header_color}} !important;
        {% endif %}
        background-image: none !important;
        font-size: 130%;
    }

    .slick-row.even {
        {% if datatable_row_color_even %}
        background-color: {{datatable_row_color_even}} !important;
        {% endif %}
    }

    .slick-row.odd {
        {% if datatable_row_color_odd %}
        background-color: {{datatable_row_color_odd}} !important;
        {% endif %}
    }

    .bk-root .bk-bs-nav-tabs>li.bk-bs-active>span {
        {% if tab_active_background_color %}
        background-color: {{tab_active_background_color}} !important;
        border-color: {{tab_active_background_color}} !important;
        {% endif %}
        {% if tab_active_color %}
        color: {{tab_active_color}} !important;
        {% endif %}
    }

    .bk-root .bk-bs-nav>li>span:hover {
        {% if tab_active_background_color %}
        background-color: {{tab_active_background_color}} !important;
        border-color: {{tab_active_background_color}} !important;
        {% endif %}
        {% if tab_active_color %}
        color: {{tab_active_color}} !important;
        {% endif %}
    }

    .bk-tooltip {
        border-radius: 3px;
        {% if tooltip_background_color %}
        background-color: {{tooltip_background_color}} !important;
        border-color: {{tooltip_background_color}} !important;
        {% endif %}
    }

    .bk-tooltip-row-label {
        {% if tooltip_text_color_label %}
        color: {{tooltip_text_color_label}} !important;
        {% endif %}
    }

    .bk-tooltip-row-value {
        {% if tooltip_text_color_value %}
        color: {{tooltip_text_color_value}} !important;
        {% endif %}
    }
</style>
